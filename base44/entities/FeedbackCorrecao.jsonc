{
  "name": "FeedbackCorrecao",
  "type": "object",
  "properties": {
    "categoria": {
      "type": "string",
      "enum": [
        "COMPETENCIA",
        "ENQUADRAMENTO",
        "TESE_JURIDICA",
        "REDACAO",
        "CALCULO",
        "GERAL"
      ],
      "title": "Categoria"
    },
    "regra_extraida": {
      "type": "string",
      "title": "Regra Extra\u00edda"
    },
    "escopo": {
      "type": "string",
      "enum": [
        "GERAL",
        "FUNCAO_ESPECIFICA",
        "MUNICIPIO_ESPECIFICO"
      ],
      "default": "GERAL",
      "title": "Escopo"
    },
    "filtro_aplicavel": {
      "type": "string",
      "title": "Filtro Aplic\u00e1vel (fun\u00e7\u00e3o/munic\u00edpio/escala)"
    },
    "mensagem_original": {
      "type": "string",
      "title": "Mensagem original do advogado"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "title": "Ativo"
    }
  },
  "required": [
    "categoria",
    "regra_extraida"
  ]
}